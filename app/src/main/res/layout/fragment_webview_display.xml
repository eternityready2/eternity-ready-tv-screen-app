<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/fullscreen_html5_player_view"
        android:orientation="vertical"/>

    <com.weternityreadymedia.eternityready.eternityreadytv.views.webview.VideoEnabledWebView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/display_webview"/>

    <ProgressBar
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:id="@+id/progress_bar"
        android:layout_gravity="center"
        android:indeterminateTint="@color/fastlane_background"/>
</FrameLayout>